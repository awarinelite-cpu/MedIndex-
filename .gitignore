# dependencies
/node_modules

# production build
/build

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Capacitor native projects ───────────────────────────────────────────
# android/ and ios/ project files ARE committed (Capacitor convention),
# just not their build outputs, dependency caches, or local machine config.
android/app/build
android/.gradle
android/local.properties
android/captures
android/*.iml
android/.idea

ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/App/App.xcworkspace/xcuserdata
ios/App/App.xcodeproj/xcuserdata
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata

# These are copied in fresh from /build on every `npx cap sync` — no need
# to track a duplicate of the web bundle inside each native project.
android/app/src/main/assets/public
ios/App/App/public
