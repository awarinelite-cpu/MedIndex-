rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Drugs — public read, signed-in write
    match /drugs/{drugId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Procedures — same access pattern as Drugs: public read, signed-in
    // write (contributor-role gating for the review queue happens
    // client-side in aiProcedureSave.js, same as drugs).
    match /procedures/{procedureId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // App config (conditions, settings) — public read, signed-in write
    match /app_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Condition clinical info — one document per condition (moved out of
    // app_config/condition_clinical_info, which hit Firestore's 1 MB
    // per-document limit once enough conditions had info saved). Same
    // access pattern as app_config: public read, signed-in write.
    match /condition_clinical_info/{conditionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admins — only read own record
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-user data (saved drug lists, etc.) — owner or admin only, never
    // other users. Admins get read access so the admin panel can show a
    // user's saved lists; only the owner can write their own data.
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;

      // AI credit wallet — read-only for the owner (or admin); writes are
      // never allowed from the client, only from server routes using the
      // Admin SDK (which bypasses these rules entirely). This is what
      // actually stops someone from editing their own balance in devtools.
      match /wallet/{doc} {
        allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }

      match /{document=**} {
        allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Credit purchase ledger — one doc per Paystack reference, written only
    // by the server (verify/webhook routes) to guard against double-
    // crediting. A user can read their own purchase history; nobody can
    // write to it from the client.
    match /credit_purchases/{reference} {
      allow read:  if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Search history — any signed-in user can log their own searches;
    // only admins can read the log (it's not meant to be browsable by users).
    match /search_logs/{logId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    // AI Assistant audit log — every edit made through the "instruct the
    // app" admin tool is logged here for accountability. Only admins can
    // read or write it (the client only ever creates entries; nothing
    // updates or deletes them).
    match /ai_admin_edit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Telegram bot account linking — a signed-in user may create a link
    // code for THEMSELVES (uid must match), never read/update/delete one
    // (redemption happens server-side via the Admin SDK in
    // api/telegram-bot.js, which bypasses these rules). The resulting
    // telegram_links/{uid} doc is owner-read-only and never client-written
    // (only the bot's webhook, via Admin SDK, links/unlinks it) — this
    // stops a user from linking someone else's uid to their own chat.
    match /link_codes/{code} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if false;
    }
    match /telegram_links/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Only the user themself may unlink (delete) from the web app;
      // creating/updating the link happens only server-side when a code
      // is redeemed, via the Admin SDK (which bypasses these rules).
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Everything else — signed-in only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
